# =============================================================================
# Community App — Environment Variables (example)
# =============================================================================
# Copy this file to `.env.local` and fill in real values for your environment.
# Never commit `.env.local`. Production values live in your hosting provider's
# secret manager (Vercel, Netlify, etc.), not in this repo.
# =============================================================================

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay (server) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Razorpay (client-exposed) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Razorpay subscription plans ──
# Legacy single-tier monthly plan ID. Kept during the Phase 2 transition for
# back-compat with code paths that have not yet adopted the three-tier flow.
# Safe to remove after Phase 2 cutover is complete and no callers default to
# 'library' tier with a missing tier-specific plan ID.
RAZORPAY_PLAN_ID_MONTHLY=

# Phase 2: created in Razorpay dashboard before going live, paste plan IDs here.
# One plan ID per product tier at the founding band price. Library = ₹499/mo,
# Workshop = ₹1,299/mo, AI Lab = ₹1,499/mo. Once a band fills, NEW plans are
# created for the next band — old plan IDs continue billing existing members
# at their locked-in price (Razorpay plans are immutable).
RAZORPAY_PLAN_ID_LIBRARY_MONTHLY=
RAZORPAY_PLAN_ID_WORKSHOP_MONTHLY=
RAZORPAY_PLAN_ID_AI_LAB_MONTHLY=

# ── Anthropic (AI features) ──
ANTHROPIC_API_KEY=
