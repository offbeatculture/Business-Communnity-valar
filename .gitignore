# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# macOS Finder duplicates (e.g. "file 2.tsx", "file 3.sql") — these get
# created silently when Finder copies files and have repeatedly slipped
# into commits. Block them at the gitignore layer.
* [0-9].ts
* [0-9].tsx
* [0-9].sql
* [0-9].js
* [0-9].mjs
* [0-9].md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local state (linked project ref, etc.)
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS Finder duplicates ("Foo 2.ts" / "Foo 3.tsx")
*\ [0-9].ts
*\ [0-9].tsx
*\ [0-9].sql

# Panchakosha session recordings live in Supabase Storage (private bucket),
# not in the repo. 233 MB in git history is permanent and every clone pays
# for it. See app/api/panchakosha/video/[kosha]/route.ts.
/public/panchakosha/
